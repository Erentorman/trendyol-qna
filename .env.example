# Local development database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://trendyol:trendyol_local_dev@127.0.0.1:5432/trendyol_qna

# Used only by pytest; tables in this DB are truncated between tests
TEST_DATABASE_URL=postgresql+psycopg2://trendyol:trendyol_local_dev@127.0.0.1:5432/trendyol_qna_test

# Trendyol API — never commit real values
# TY_BASE_URL: https://apigw.trendyol.com (prod) or https://stageapigw.trendyol.com (stage)
# TY_USER_AGENT: optional, defaults to "<TY_SUPPLIER_ID> - SelfIntegration"
TY_SUPPLIER_ID=
TY_API_KEY=
TY_API_SECRET=
TY_BASE_URL=
TY_USER_AGENT=
# Optional: storeFrontCode header for Product V2 GET (Stage product lookup)
TY_STOREFRONT_CODE=
# Seconds between polls (default 300 when empty)
POLL_INTERVAL_SECONDS=
